<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#38BDF8" android:centerColor="#0284C7" android:endColor="#0369A1" />
            <stroke android:width="3dp" android:color="#BAE6FD" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#38BDF8" android:centerColor="#0284C7" android:endColor="#0369A1" />
            <stroke android:width="1dp" android:color="#99BAE6FD" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
