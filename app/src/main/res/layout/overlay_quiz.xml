<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="学伴时光 · 答题时间到啦"
        android:textColor="#0C4A6E"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQuizSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="本轮要答对 2 道题，才能继续观看 15 分钟"
        android:textColor="#0369A1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvBannerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 正常答题卡片 -->
    <LinearLayout
        android:id="@+id/layoutQuizCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvQuestionMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="一年级 · 语文"
            android:textColor="#0284C7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvQuestionPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:text="题目加载中..."
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button android:id="@+id/btnOptA" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_option_button" android:focusable="true" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="A." android:textSize="17sp"  android:textColor="@color/btn_cloud_text" />
        <Button android:id="@+id/btnOptB" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_option_button" android:focusable="true" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="B." android:textSize="17sp"  android:textColor="@color/btn_cloud_text" />
        <Button android:id="@+id/btnOptC" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_option_button" android:focusable="true" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="C." android:textSize="17sp"  android:textColor="@color/btn_cloud_text" />
        <Button android:id="@+id/btnOptD" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_option_button" android:focusable="true" android:gravity="center_vertical|start" android:paddingHorizontal="18dp" android:text="D." android:textSize="17sp"  android:textColor="@color/btn_cloud_text" />

        <Button
            android:id="@+id/btnReplayQuestion"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_option_button"
            android:focusable="true"
            android:text="重播朗读题目"
            android:textSize="15sp"  android:textColor="@color/btn_cloud_text" />
    </LinearLayout>

    <!-- 解题思路卡片 -->
    <LinearLayout
        android:id="@+id/layoutExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvCorrectAnswer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="正确答案" android:textColor="#059669" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvExplainBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="解题思路"
            android:textColor="#334155" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <Button android:id="@+id/btnReplayExplain" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="16dp" android:text="重播讲解"  android:textColor="@color/btn_cloud_text" />
            <TextView android:id="@+id/tvWaitCountdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textColor="#0284C7" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 答完后：是否继续挑战询问卡片 -->
    <LinearLayout
        android:id="@+id/layoutContinueChallenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvContinueTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="是否继续挑战？"
            android:textColor="#0C4A6E" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvContinueSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp" android:text="挑战成功可奖励 5 分钟，答题失败扣除 5 分钟" android:textColor="#0369A1" android:textSize="16sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnContinueNo" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:background="@drawable/bg_option_button" android:focusable="true" android:text="否，开始计时观看" android:textSize="16sp"  android:textColor="@color/btn_cloud_text" />
            <Button android:id="@+id/btnContinueYes" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_option_button" android:focusable="true" android:text="是，继续挑战" android:textSize="16sp"  android:textColor="@color/btn_cloud_text" />
        </LinearLayout>
    </LinearLayout>

    <!-- 按方向键 ↑ 5次 紧急密码解锁卡片 -->
    <LinearLayout
        android:id="@+id/layoutEmergencyPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="紧急关闭守护（输入家长密码）" android:textSize="18sp" android:textStyle="bold" />
        <EditText android:id="@+id/etEmergencyPin" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:hint="请输入家长密码" android:inputType="numberPassword" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/btnConfirmEmergencyPin" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginEnd="12dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="20dp" android:text="确认关闭守护" />
            <Button android:id="@+id/btnCancelEmergencyPin" android:layout_width="wrap_content" android:layout_height="42dp" android:background="@drawable/bg_option_button" android:focusable="true" android:paddingHorizontal="20dp" android:text="取消" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
